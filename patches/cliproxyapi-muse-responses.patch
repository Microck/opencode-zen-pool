 }
 
+func dropOpenAIResponsesReasoningEncryptedContent(ctx context.Context, provider string, body []byte) []byte {
+	input := util.GetGJSONBytesNoCopy(body, "input")
+	if !input.Exists() || !input.IsArray() {
+		return body
+	}
+	items := input.Array()
+	var rebuilt []byte
+	write := func(raw string) {
+		if len(rebuilt) > 1 {
+			rebuilt = append(rebuilt, ',')
+		}
+		rebuilt = append(rebuilt, raw...)
+	}
+	start := func(index int) {
+		if rebuilt != nil {
+			return
+		}
+		rebuilt = []byte{'['}
+		for i := 0; i < index; i++ {
+			write(items[i].Raw)
+		}
+	}
+	for index, item := range items {
+		raw := item.Raw
+		if item.Get("type").String() != "reasoning" || !item.Get("encrypted_content").Exists() {
+			if rebuilt != nil {
+				write(raw)
+			}
+			continue
+		}
+		next, err := sjson.Delete(raw, "encrypted_content")
+		if err == nil {
+			next, err = sjson.Delete(next, "id")
+		}
+		if err != nil {
+			helps.LogWithRequestID(ctx).Debugf("%s: failed to drop caller-bound reasoning at input[%d]: %v", provider, index, err)
+			if rebuilt != nil {
+				write(raw)
+			}
+			continue
+		}
+		start(index)
+		write(next)
+	}
+	if rebuilt == nil {
+		return body
+	}
+	rebuilt = append(rebuilt, ']')
+	updated, err := sjson.SetRawBytes(body, "input", rebuilt)
+	if err != nil {
+		return body
+	}
+	return updated
+}
