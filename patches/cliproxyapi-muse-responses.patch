+func (e *OpenAICompatExecutor) sanitizeMuseCallerHandoff(ctx context.Context, auth *cliproxyauth.Auth, opts cliproxyexecutor.Options, body []byte) []byte {
+	session := ""
+	for key, values := range opts.Headers {
+		if strings.EqualFold(key, "x-opencode-session") && len(values) > 0 {
+			session = strings.TrimSpace(values[0])
+			break
+		}
+	}
+	if session == "" {
+		session = "<anonymous>"
+	}
+	authID := "<anonymous>"
+	if auth != nil && strings.TrimSpace(auth.ID) != "" {
+		authID = auth.ID
+	}
+	affinity := session + "\x00" + e.provider
+	e.affinityMu.Lock()
+	previous, known := e.affinity[affinity]
+	e.affinity[affinity] = authID
+	e.affinityMu.Unlock()
+	if known && previous == authID {
+		return sanitizeOpenAIResponsesReasoningEncryptedContent(ctx, "openai compat Muse handoff", body)
+	}
+	body = dropOpenAIResponsesReasoningEncryptedContent(ctx, "openai compat Muse handoff", body)
+	return sanitizeOpenAIResponsesReasoningEncryptedContent(ctx, "openai compat Muse handoff", body)
+}
+
 func openAICompatErrorEvent(eventName string) bool {
 	return strings.EqualFold(eventName, "error") || strings.EqualFold(eventName, "response.error") || strings.EqualFold(eventName, "response.failed")
 }
