+func TestDropOpenAIResponsesReasoningEncryptedContentPreservesConversation(t *testing.T) {
+	body := []byte(`{"input":[` +
+		`{"type":"message","role":"user","content":[{"type":"input_text","text":"hello"}]},` +
+		`{"id":"rs_old","type":"reasoning","summary":[],"encrypted_content":"caller-bound"},` +
+		`{"type":"function_call","name":"read","call_id":"call_1","arguments":"{}"}` +
+		`]}`)
+
+	got := dropOpenAIResponsesReasoningEncryptedContent(context.Background(), "test", body)
+	if gjson.GetBytes(got, "input.1.encrypted_content").Exists() || gjson.GetBytes(got, "input.1.id").Exists() {
+		t.Fatalf("caller-bound reasoning fields remain: %s", got)
+	}
+	count := gjson.GetBytes(got, "input.#").Int()
+	if count != 3 {
+		t.Fatalf("input item count = %d, want 3; body=%s", count, got)
+	}
+	if gjson.GetBytes(got, "input.0.content.0.text").String() != "hello" || gjson.GetBytes(got, "input.2.name").String() != "read" {
+		t.Fatalf("conversation items changed: %s", got)
+	}
+}
